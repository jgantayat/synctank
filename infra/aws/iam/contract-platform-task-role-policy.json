{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPlatformSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:synctank/platform-??????"
    },
    {
      "Sid": "ListSpecBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${SPEC_BUCKET}"
    },
    {
      "Sid": "ReadWriteSpecObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${SPEC_BUCKET}/specs/*"
    }
  ]
}