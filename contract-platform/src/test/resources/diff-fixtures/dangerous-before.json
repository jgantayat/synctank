{
  "openapi": "3.0.1",
  "info": {"title": "Orders API", "version": "1.0"},
  "paths": {
    "/api/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "responses": {
          "200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderResponse": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "status": {"type": "string", "nullable": false, "enum": ["PENDING", "SHIPPED", "DELIVERED", "CANCELLED"]},
          "amount": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}